#include <bits/stdc++.h>
using namespace std;
int digit_sum(string n)
{
    if(n.size() <2)
    {
        return 0;
    }
    int sum=0;
 for (char c: n){
    sum= sum+(c-'0');
 }
    return 1+digit_sum(to_string(sum));

}
int main()
{
   string n;
    cin>>n;

    int k= digit_sum(n);

    cout<<k<<endl;
}
